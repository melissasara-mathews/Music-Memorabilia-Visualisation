{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 900,
  "height": 450,

  "background": "#BFDFF2",

  "params": [
    {
      "name": "venueTypeFilter",
      "value": "All",
      "bind": {
        "input": "select",
        "name": "Filter venue type: ",
        "options": [
          "All",
          "Bar",
          "Nightclub",
          "Hotel",
          "Performance Space",
          "Venue",
          "Theatre",
          "Gallery",
          "Museum"
        ]
      }
    }
  ],

  "projection": {
    "type": "equirectangular",
    "center": [144.97, -37.815],
    "scale": 360000
  },

  "layer": [
    {
      "data": {
        "url": "data/clean/VIC_LOCALITY_POLYGON_SHP.json",
        "format": {
          "type": "topojson",
          "feature": "VIC_LOCALITY_POLYGON_SHP"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#C9D8B6",
        "stroke": "#F7F4EC",
        "strokeWidth": 0.7
      }
    },

    {
      "data": {
        "url": "data/clean/melbourne_rivers.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "transform": [
        {
          "filter": "datum.properties['@id'] == 'relation/2211681' || datum.properties['@id'] == 'relation/4762727'"
        }
      ],

      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#5DA5D3",
        "strokeWidth": 2.3,
        "opacity": 0.95
      },

      "encoding": {
        "tooltip": {
          "field": "properties.name",
          "type": "nominal",
          "title": "River"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "name": "Brunswick",
            "lon": 144.956,
            "lat": -37.766
          },
          {
            "name": "Parkville",
            "lon": 144.946,
            "lat": -37.787
          },
          {
            "name": "Carlton",
            "lon": 144.969,
            "lat": -37.793
          },
          {
            "name": "Fitzroy",
            "lon": 144.985,
            "lat": -37.794
          },
          {
            "name": "Collingwood",
            "lon": 144.997,
            "lat": -37.801
          },
          {
            "name": "Melbourne",
            "lon": 144.958,
            "lat": -37.808
          },
          {
            "name": "Docklands",
            "lon": 144.938,
            "lat": -37.818
          },
          {
            "name": "Richmond",
            "lon": 145.008,
            "lat": -37.824
          },
          {
            "name": "South Yarra",
            "lon": 145.001,
            "lat": -37.844
          },
          {
            "name": "St Kilda",
            "lon": 144.981,
            "lat": -37.858
          }
        ]
      },

      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 14,
        "fontWeight": "normal",
        "color": "#59645F",
        "opacity": 1
      },

      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },

        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },

        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "name": "Yarra River",
            "lon": 145.014,
            "lat": -37.833
          }
        ]
      },

      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#4D91BF",
        "opacity": 1
      },

      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },

        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },

        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },

    {
      "data": {
        "url": "data/clean/venues_clean.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number"
          }
        }
      },

      "transform": [
        {
          "filter": "isValid(datum.lat) && isValid(datum.lon)"
        },
        {
          "filter": "datum.space_type != 'Unknown'"
        },
        {
          "filter": "venueTypeFilter == 'All' || datum.space_type == venueTypeFilter"
        }
      ],

      "mark": {
        "type": "circle",
        "size": 52,
        "opacity": 0.9,
        "strokeWidth": 0
      },

      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },

        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },

        "color": {
          "field": "space_type",
          "type": "nominal",
          "title": "Venue type",

          "scale": {
            "domain": [
              "Bar",
              "Nightclub",
              "Hotel",
              "Performance Space",
              "Venue",
              "Theatre",
              "Gallery",
              "Museum"
            ],

            "range": [
              "#287D46",
              "#252525",
              "#D74F79",
              "#E85D43",
              "#3559A8",
              "#5478D6",
              "#A36C32",
              "#85509B"
            ]
          },

          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 3,
            "title": "Venue type",
            "titleFont": "Arial",
            "titleFontSize": 13,
            "titleColor": "#20243A",
            "labelFont": "Arial",
            "labelFontSize": 12,
            "labelColor": "#20243A",
            "symbolType": "circle",
            "symbolSize": 100
          }
        },

        "tooltip": [
          {
            "field": "venue_name",
            "type": "nominal",
            "title": "Venue"
          },
          {
            "field": "space_type",
            "type": "nominal",
            "title": "Venue type"
          },
          {
            "field": "venue_address",
            "type": "nominal",
            "title": "Address"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}