
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 470,
  "background": "transparent",
  "params": [
    {
      "name": "venueTypeFilter",
      "value": "Bar"
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": [144.97, -37.815],
    "scale": 360000
  },
  "layer": [
    {
      "data": {
        "url": "data/clean/VIC_LOCALITY_POLYGON_SHP.topojson",
        "format": {
          "type": "topojson",
          "feature": "VIC_LOCALITY_POLYGON_SHP"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#C9D8B6",
        "stroke": "#F7F4EC",
        "strokeWidth": 0.55, 
        "strokeOpacity": 0.85
      }
    },
    
    {
      "data": {
        "url": "data/clean/melbourne_boundary.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#F7F4EC",
        "strokeWidth": 0.55,
        "strokeOpacity": 0.85
      }
    }, 
    {
      "data": {
        "url": "data/clean/melbourne_rivers.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties['@id'] == 'relation/2211681' || datum.properties['@id'] == 'relation/4762727'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#5DA5D3",
        "strokeWidth": 2,
        "opacity": 0.9
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Brunswick",
            "lon": 144.956,
            "lat": -37.766
          },
          {
            "name": "Parkville",
            "lon": 144.946,
            "lat": -37.787
          },
          {
            "name": "Carlton",
            "lon": 144.969,
            "lat": -37.793
          },
          {
            "name": "Fitzroy",
            "lon": 144.985,
            "lat": -37.794
          },
          {
            "name": "Collingwood",
            "lon": 144.997,
            "lat": -37.801
          },
          {
            "name": "Melbourne",
            "lon": 144.963,
            "lat": -37.802
          },
          {
            "name": "Docklands",
            "lon": 144.934,
            "lat": -37.815
          },
          {
            "name": "Richmond",
            "lon": 145.008,
            "lat": -37.824
          },
          {
            "name": "South Yarra",
            "lon": 145.001,
            "lat": -37.844
          },
          {
            "name": "St Kilda",
            "lon": 144.981,
            "lat": -37.858
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 12,
        "color": "#59645F",
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [

          {
            "name": "Yarra River",
            "lon": 145.016,
            "lat": -37.836
          },
          {
            "name": "Maribyrnong River",
            "lon": 144.901,
            "lat": -37.805
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#347FAE",
        "dy": -8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/clean/venues_clean.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.lat) && isValid(datum.lon)"
        },
        {
          "filter": "isValid(datum.space_type) && datum.space_type != 'Unknown' && datum.space_type != ''"
        }
      ],

      "mark": {
        "type": "circle",
        "stroke": null,
        "strokeWidth": 0
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.space_type == venueTypeFilter",
            "value": "#2455A4"
          },
          "value": "#D7EF57"
        },
        "opacity": {
          "condition": {
            "test": "datum.space_type == venueTypeFilter",
            "value": 1
          },
          "value": 0.85
        },
        "size": {
          "condition": {
            "test": "datum.space_type == venueTypeFilter",
            "value": 85
          },
          "value": 48
        },
        "stroke": {
          "value": "#53614A"
        },
        "strokeWidth": {
          "value": 0.5
        },
        "tooltip": [
          {
            "field": "venue_name",
            "type": "nominal",
            "title": "Venue"
          },
          {
            "field": "space_type",
            "type": "nominal",
            "title": "Venue type"
          },
          {
            "field": "venue_address",
            "type": "nominal",
            "title": "Address"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "fill": "#BFDFF2",
      "stroke": null
    }
  }
}
