{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 900,
  "height": 430,

  "background": "#FAF7F1",

  "projection": {
    "type": "equirectangular",
    "center": [144.965, -37.812],
    "scale": 220000
  },

  "layer": [
    {
      "data": {
        "url": "data/clean/VIC_LOCALITY_POLYGON_SHP.json",
        "format": {
          "type": "topojson",
          "feature": "VIC_LOCALITY_POLYGON_SHP"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#EAE5DB",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.7
      },

      "encoding": {
        "tooltip": {
          "field": "properties.NAME",
          "type": "nominal",
          "title": "Suburb"
        }
      }
    },

    {
      "data": {
        "url": "data/clean/VIC_LOCALITY_LABELS.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "transform": [
        {
          "filter": "datum.geometry != null"
        },
        {
          "calculate": "datum.geometry.coordinates[0]",
          "as": "label_lon"
        },
        {
          "calculate": "datum.geometry.coordinates[1]",
          "as": "label_lat"
        }
      ],

      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 9,
        "fontWeight": "normal",
        "color": "#6F7180",
        "opacity": 0.9
      },

      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },

        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },

        "text": {
          "field": "properties.NAME",
          "type": "nominal"
        }
      }
    },

    {
      "data": {
        "url": "data/clean/venues_clean.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number"
          }
        }
      },

      "transform": [
        {
          "filter": "isValid(datum.lat) && isValid(datum.lon)"
        }
      ],

      "mark": {
        "type": "circle",
        "size": 30,
        "color": "#E85D43",
        "opacity": 0.78,
        "stroke": "#FAF7F1",
        "strokeWidth": 0.4
      },

      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },

        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "venue_name",
            "type": "nominal",
            "title": "Venue"
          },
          {
            "field": "space_type",
            "type": "nominal",
            "title": "Venue type"
          },
          {
            "field": "venue_address",
            "type": "nominal",
            "title": "Address"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}