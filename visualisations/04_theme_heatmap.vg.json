
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 390,
  "height": 225,
  "background": "#F7F3EB",

  "params": [
    {
      "name": "selectedThemes",
      "value": []
    }
  ],

  "data": {
    "url": "data/clean/theme_period_counts.csv"
  },

  "transform": [
    {
      "filter": "datum.historical_period != 'Unknown'"
    },
    {
      "impute": "record_count",
      "key": "historical_period",
      "groupby": ["theme"],
      "keyvals": [
        "Before 1900",
        "1900-1909",
        "1910-1919",
        "1920-1929",
        "1930-1939",
        "1940-1959"
      ],
      "value": 0
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#F7F3EB",
        "strokeWidth": 2
      },

      "encoding": {
        "x": {
          "field": "historical_period",
          "type": "ordinal",
          "sort": [
            "Before 1900",
            "1900-1909",
            "1910-1919",
            "1920-1929",
            "1930-1939",
            "1940-1959"
          ],
          "title": null,
          "axis": {
            "orient": "top",
            "labelFont": "DM Sans",
            "labelFontSize": 12,
            "labelFontWeight": "normal",
            "labelColor": "#20243A",
            "labelAngle": 0,
            "labelPadding": 12,
            "labelLimit": 95,
            "labelExpr": "datum.label === 'Before 1900' ? 'Pre-1900' : replace(datum.label, '-', '–')",
            "ticks": false,
            "domain": false
          }
        },

        "y": {
          "field": "theme",
          "type": "nominal",
          "title": null,
          "sort": [
            "Piano / dance",
            "Songs",
            "Patriotic / national",
            "War",
            "Other"
          ],
          "axis": {
            "labelFont": "DM Sans",
            "labelFontSize": 13,
            "labelFontWeight": "normal",
            "labelColor": "#20243A",
            "labelPadding": 12,
            "labelLimit": 180,
            "ticks": false,
            "domain": false
          }
        },

        "color": {
          "field": "record_count",
          "type": "quantitative",
          "title": "Records",
          "scale": {
            "domain": [0, 4],
            "range": [
              "#D2D9E3",
              "#A9B7CA",
              "#8094AE",
              "#536C8B",
              "#304762"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "titleFont": "DM Sans",
            "titleFontSize": 13,
            "titleFontWeight": "normal",
            "titleColor": "#20243A",
            "labelFont": "DM Sans",
            "labelFontSize": 13,
            "labelFontWeight": "normal",
            "labelColor": "#20243A",
            "gradientLength": 140,
            "gradientThickness": 9
          }
        },

        "opacity": {
          "condition": {
            "test": "length(selectedThemes) == 0 || indexof(selectedThemes, datum.theme) >= 0",
            "value": 1
          },
          "value": 0.18
        },

        "tooltip": [
          {
            "field": "historical_period",
            "type": "nominal",
            "title": "Historical period"
          },
          {
            "field": "theme",
            "type": "nominal",
            "title": "Theme"
          },
          {
            "field": "record_count",
            "type": "quantitative",
            "title": "Records",
            "format": "d"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.record_count >= 3"
        }
      ],

      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontSize": 14,
        "fontWeight": "normal"
      },

      "encoding": {
        "x": {
          "field": "historical_period",
          "type": "ordinal",
          "sort": [
            "Before 1900",
            "1900-1909",
            "1910-1919",
            "1920-1929",
            "1930-1939",
            "1940-1959"
          ]
        },

        "y": {
          "field": "theme",
          "type": "nominal",
          "sort": [
            "Piano / dance",
            "Songs",
            "Patriotic / national",
            "War",
            "Other"
          ]
        },

        "text": {
          "field": "record_count",
          "type": "quantitative",
          "format": "d"
        },

        "color": {
          "value": "#FFFFFF"
        },

        "opacity": {
          "condition": {
            "test": "length(selectedThemes) == 0 || indexof(selectedThemes, datum.theme) >= 0",
            "value": 1
          },
          "value": 0.18
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans"
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans"
    }
  }
}
