
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 390,
  "height": 225,
  "background": "#F7F3EB",

  "data": {
    "url": "data/clean/theme_period_counts.csv"
  },

  "transform": [
    {
      "filter": "datum.historical_period != 'Unknown'"
    },
    {
      "impute": "record_count",
      "key": "historical_period",
      "groupby": ["theme"],
      "keyvals": [
        "Before 1900",
        "1900-1909",
        "1910-1919",
        "1920-1929",
        "1930-1939",
        "1940-1959"
      ],
      "value": 0
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#F7F3EB",
        "strokeWidth": 2
      },

      "encoding": {
        "x": {
          "field": "historical_period",
          "type": "ordinal",

          "sort": [
            "Before 1900",
            "1900-1909",
            "1910-1919",
            "1920-1929",
            "1930-1939",
            "1940-1959"
          ],

          "title": null,

          "axis": {
            "orient": "top",
            "labelFont": "Arial",
            "labelFontSize": 9,
            "labelColor": "#20243A",
            "labelAngle": 0,
            "labelPadding": 10,
            "ticks": false,
            "domain": false
          }
        },

        "y": {
          "field": "theme",
          "type": "nominal",

          "title": null,

          "sort": [
            "Piano / dance",
            "Songs",
            "Patriotic / national",
            "War",
            "Other"
          ],

          "axis": {
            "labelFont": "Arial",
            "labelFontSize": 10,
            "labelColor": "#20243A",
            "labelPadding": 12,
            "ticks": false,
            "domain": false
          }
        },

        "color": {
          "field": "record_count",
          "type": "quantitative",

          "title": "Records",

          "scale": {
            "domain": [0, 4],
            "range": [
              "#D2D9E3",
              "#A9B7CA",
              "#8094AE",
              "#536C8B",
              "#304762"
            ]
          },

          "legend": {
            "orient": "top",
            "direction": "horizontal",

            "titleFont": "Arial",
            "titleFontSize": 9,
            "titleFontWeight": "bold",
            "titleColor": "#6F7180",

            "labelFont": "Arial",
            "labelFontSize": 9,
            "labelColor": "#6F7180",

            "gradientLength": 140,
            "gradientThickness": 7
          }
        },

        "tooltip": [
          {
            "field": "historical_period",
            "type": "nominal",
            "title": "Historical period"
          },
          {
            "field": "theme",
            "type": "nominal",
            "title": "Theme"
          },
          {
            "field": "record_count",
            "type": "quantitative",
            "title": "Records"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.record_count >= 3"
        }
      ],

      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": "bold"
      },

      "encoding": {
        "x": {
          "field": "historical_period",
          "type": "ordinal",

          "sort": [
            "Before 1900",
            "1900-1909",
            "1910-1919",
            "1920-1929",
            "1930-1939",
            "1940-1959"
          ]
        },

        "y": {
          "field": "theme",
          "type": "nominal",

          "sort": [
            "Piano / dance",
            "Songs",
            "Patriotic / national",
            "War",
            "Other"
          ]
        },

        "text": {
          "field": "record_count",
          "type": "quantitative"
        },

        "color": {
          "value": "#FFFFFF"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}
