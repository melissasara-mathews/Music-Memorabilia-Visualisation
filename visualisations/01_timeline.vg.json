
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "background": "#F7F3EB",
  "data": {
    "url": "data/clean/music_qld_clean.csv"
  },
  "params": [
    {
      "name": "selectedThemes",
      "value": []
    }
  ],
  "transform": [
    {
      "filter": "isValid(datum.year) && datum.year >= 1880 && datum.year <= 1960"
    },
    {
      "filter": "length(selectedThemes) === 0 || indexof(selectedThemes, datum.theme) >= 0"
    }
  ],
  "mark": {
    "type": "circle",
    "size": 100,
    "opacity": 0.9,
    "stroke": "#F7F3EB",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [1880, 1960],
        "nice": false
      },
      "axis": {
        "values": [1880, 1900, 1920, 1940, 1960],
        "format": "d",
        "labelFontSize": 13,
        "labelColor": "#6F7180",
        "labelPadding": 12,
        "domainColor": "#C8C3B6",
        "tickColor": "#C8C3B6",
        "grid": false
      }
    },
    "y": {
      "field": "theme",
      "type": "nominal",
      "title": null,
      "sort": [
        "Piano / dance",
        "War",
        "Patriotic / national",
        "Songs",
        "Queensland / place",
        "Other"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "grid": false,
        "labelFontSize": 13,
        "labelColor": "#293348",
        "labelPadding": 14,
        "labelLimit": 190
      }
    },
    "color": {
      "field": "theme",
      "type": "nominal",
      "scale": {
        "domain": [
          "Piano / dance",
          "War",
          "Patriotic / national",
          "Songs",
          "Queensland / place",
          "Other"
        ],
        "range": [
          "#1FA4B6",
          "#E75480",
          "#458C6B",
          "#876EB2",
          "#FFDB58",
          "#84465C"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "title_display",
        "type": "nominal",
        "title": "Music title"
      },
      {
        "field": "creator_clean",
        "type": "nominal",
        "title": "Creator"
      },
      {
        "field": "year",
        "type": "quantitative",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "theme",
        "type": "nominal",
        "title": "Theme"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 12,
    "bottom": 8
  }
}
