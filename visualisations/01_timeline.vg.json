{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 1000,
  "height": 220,
  "background": "#F7F3EB",

  "data": {
    "url": "../data/clean/music_qld_clean.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number"
      }
    }
  },

  "transform": [
    {
      "filter": "datum.year != null && datum.year >= 1880 && datum.year <= 1960"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "stack_position"
        }
      ],
      "groupby": ["year"],
      "sort": [
        {
          "field": "theme",
          "order": "ascending"
        }
      ]
    }
  ],

  "mark": {
    "type": "circle",
    "filled": true,
    "size": 170,
    "opacity": 1,
    "stroke": "#F7F3EB",
    "strokeWidth": 1.5
  },

  "encoding": {

    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,

      "scale": {
        "domain": [1880, 1960],
        "nice": false
      },

      "axis": {
        "values": [1880, 1900, 1920, 1940, 1960],
        "format": "d",

        "labelFont": "Arial",
        "labelFontSize": 13,
        "labelColor": "#6F7180",
        "labelPadding": 12,

        "domain": true,
        "domainColor": "#C8C3B6",
        "domainWidth": 1.2,

        "tickColor": "#C8C3B6",
        "tickSize": 8,

        "grid": false
      }
    },

    "y": {
      "field": "stack_position",
      "type": "ordinal",
      "axis": null,

      "scale": {
        "padding": 0.65
      }
    },

    "color": {
      "field": "theme",
      "type": "nominal",
      "title": null,

      "scale": {
        "domain": [
          "Songs",
          "Patriotic / national",
          "War",
          "Piano / dance",
          "Queensland / place",
          "Other"
        ],

        "range": [
          "#E85D43",
          "#E8AA3B",
          "#B64E59",
          "#6A56AF",
          "#4E7FA9",
          "#96968E"
        ]
      },

      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "columns": 3,

        "symbolType": "circle",
        "symbolSize": 70,

        "labelFont": "Arial",
        "labelFontSize": 11,
        "labelColor": "#6F7180",

        "columnPadding": 20,
        "rowPadding": 8,

        "offset": 18
      }
    },

    "tooltip": [
      {
        "field": "Title",
        "type": "nominal",
        "title": "Title"
      },
      {
        "field": "creator_clean",
        "type": "nominal",
        "title": "Creator"
      },
      {
        "field": "Date",
        "type": "nominal",
        "title": "Original date"
      },
      {
        "field": "year",
        "type": "quantitative",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "theme",
        "type": "nominal",
        "title": "Theme"
      },
      {
        "field": "Publisher",
        "type": "nominal",
        "title": "Publisher"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },

    "axis": {
      "titleFont": "Arial",
      "labelFont": "Arial"
    },

    "legend": {
      "titleFont": "Arial",
      "labelFont": "Arial"
    }
  }
}