
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "spacing": 24,

  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labels": false,
      "grid": false,
      "title": null
    }
  },

  "hconcat": [
    {
      "width": 420,
      "height": 420,

      "data": {
        "url": "data/clean/abs_frequency.csv",
        "format": {
          "type": "csv",
          "parse": {
            "percentage": "number"
          }
        }
      },

      "transform": [
        {
          "calculate": "datum.frequency == 'Once' ? 'Once' : datum.frequency == 'Twice' ? 'Twice' : datum.frequency == '3 times' || datum.frequency == '4 times' || datum.frequency == '5 times' ? '3–5 times' : datum.frequency == '6-10 times' ? '6–10 times' : '11 or more times'",
          "as": "group"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "percentage",
              "as": "pct"
            }
          ],
          "groupby": ["group"]
        },
        {
          "calculate": "format(datum.pct, '.1f') + '%'",
          "as": "pct_label"
        },
        {
          "calculate": "datum.group == 'Once' ? 1 : datum.group == 'Twice' ? 2 : datum.group == '3–5 times' ? 3 : datum.group == '6–10 times' ? 4 : 5",
          "as": "order"
        },
        {
          "calculate": "datum.order == 1 ? '#48D1CC' : datum.order == 2 ? '#00637C' : datum.order == 3 ? '#E9C46A' : datum.order == 4 ? '#A47BC1' : '#A65A32'",
          "as": "color"
        },
        {
          "calculate": "round(datum.pct)",
          "as": "square_count"
        },
        {
          "window": [
            {
              "op": "sum",
              "field": "square_count",
              "as": "cume"
            }
          ],
          "sort": [
            {
              "field": "order",
              "order": "ascending"
            }
          ]
        },
        {
          "calculate": "datum.cume - datum.square_count",
          "as": "start"
        },
        {
          "calculate": "sequence(0, datum.square_count)",
          "as": "squareIndex"
        },
        {
          "flatten": ["squareIndex"]
        },
        {
          "calculate": "datum.start + datum.squareIndex",
          "as": "id"
        },
        {
          "calculate": "datum.id % 10",
          "as": "col"
        },
        {
          "calculate": "floor(datum.id / 10)",
          "as": "row"
        }
      ],

      "mark": {
        "type": "square",
        "size": 1250,
        "filled": true,
        "stroke": "#F7F3EB",
        "strokeWidth": 1
      },

      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "sort": "ascending",
          "scale": {
            "paddingInner": 0.12,
            "paddingOuter": 0.08
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "sort": "ascending",
          "scale": {
            "paddingInner": 0.12,
            "paddingOuter": 0.08
          }
        },
        "color": {
          "field": "color",
          "type": "nominal",
          "scale": null,
          "legend": null
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Attendance frequency"
          },
          {
            "field": "pct_label",
            "type": "nominal",
            "title": "Percentage of attendees"
          }
        ]
      }
    },

    {
      "width": 300,
      "height": 420,

      "data": {
        "url": "data/clean/abs_frequency.csv",
        "format": {
          "type": "csv",
          "parse": {
            "percentage": "number"
          }
        }
      },

      "transform": [
        {
          "calculate": "datum.frequency == 'Once' ? 'Once' : datum.frequency == 'Twice' ? 'Twice' : datum.frequency == '3 times' || datum.frequency == '4 times' || datum.frequency == '5 times' ? '3–5 times' : datum.frequency == '6-10 times' ? '6–10 times' : '11 or more times'",
          "as": "group"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "percentage",
              "as": "pct"
            }
          ],
          "groupby": ["group"]
        },
        {
          "calculate": "datum.group == 'Once' ? 1 : datum.group == 'Twice' ? 2 : datum.group == '3–5 times' ? 3 : datum.group == '6–10 times' ? 4 : 5",
          "as": "order"
        },
        {
          "calculate": "datum.order == 1 ? '#48D1CC' : datum.order == 2 ? '#00637C' : datum.order == 3 ? '#E9C46A' : datum.order == 4 ? '#A47BC1' : '#A65A32'",
          "as": "color"
        },
        {
          "calculate": "50 + (datum.order - 1) * 52",
          "as": "ypos"
        },
        {
          "calculate": "format(datum.pct, '.1f') + '%'",
          "as": "pct_label"
        }
      ],

      "layer": [
        {
          "data": {
            "values": [{}]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "font": "DM Sans",
            "fontSize": 14,
            "fontWeight": "normal",
            "color": "#59645F"
          },
          "encoding": {
            "x": {
              "value": 12
            },
            "y": {
              "value": 14
            },
            "text": {
              "value": "Each square ≈ 1% of attendees"
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "shape": "square",
            "filled": true,
            "size": 180
          },
          "encoding": {
            "x": {
              "value": 20
            },
            "y": {
              "field": "ypos",
              "type": "quantitative",
              "scale": null
            },
            "color": {
              "field": "color",
              "type": "nominal",
              "scale": null,
              "legend": null
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "font": "DM Sans",
            "fontSize": 15,
            "fontWeight": "normal",
            "color": "#20243A"
          },
          "encoding": {
            "x": {
              "value": 40
            },
            "y": {
              "field": "ypos",
              "type": "quantitative",
              "scale": null
            },
            "text": {
              "field": "group",
              "type": "nominal"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "font": "DM Sans",
            "fontSize": 18,
            "fontWeight": "normal",
            "color": "#20243A"
          },
          "encoding": {
            "x": {
              "value": 284
            },
            "y": {
              "field": "ypos",
              "type": "quantitative",
              "scale": null
            },
            "text": {
              "field": "pct_label",
              "type": "nominal"
            }
          }
        },
        {
          "data": {
            "values": [{}]
          },
          "mark": {
            "type": "rule",
            "color": "#C8C3B6",
            "strokeWidth": 1
          },
          "encoding": {
            "x": {
              "value": 12
            },
            "x2": {
              "value": 284
            },
            "y": {
              "value": 318
            }
          }
        },
        {
          "data": {
            "values": [{}]
          },
          "mark": {
            "type": "text",
            "font": "DM Sans",
            "fontSize": 16,
            "fontWeight": "normal",
            "color": "#20243A",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "value": 12
            },
            "y": {
              "value": 348
            },
            "text": {
              "value": "64.9% attended once or twice"
            }
          }
        },
        {
          "data": {
            "values": [{}]
          },
          "mark": {
            "type": "text",
            "font": "DM Sans",
            "fontSize": 16,
            "fontWeight": "normal",
            "color": "#20243A",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "value": 12
            },
            "y": {
              "value": 380
            },
            "text": {
              "value": "13.1% attended six or more times"
            }
          }
        },
        {
          "data": {
            "values": [{}]
          },
          "mark": {
            "type": "text",
            "font": "DM Sans",
            "fontSize": 12,
            "fontWeight": "normal",
            "color": "#59645F",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "value": 12
            },
            "y": {
              "value": 410
            },
            "text": {
              "value": "Survey estimates in rounded percentages"
            }
          }
        }
      ]
    }
  ]
}
