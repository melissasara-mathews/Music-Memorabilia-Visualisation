{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 420,
  "height": 330,

  "background": "#F7F3EB",

  "data": {
    "url": "data/clean/abs_age_gender.csv",
    "format": {
      "type": "csv",
      "parse": {
        "male": "number",
        "female": "number"
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#C8C9CF",
        "strokeWidth": 2
      },

      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": [
            "15-17",
            "18-24",
            "25-34",
            "35-44",
            "45-54",
            "55-64",
            "65-74",
            "75+"
          ],
          "title": null,
          "axis": {
            "labelFont": "DM Sans",
            "labelFontSize": 14,
            "labelColor": "#20243A",
            "labelPadding": 10,
            "ticks": false,
            "domain": false
          }
        },

        "x": {
          "field": "male",
          "type": "quantitative",
          "title": "Attendance rate (%)",
          "scale": {
            "domain": [0, 30]
          },
          "axis": {
            "titleFont": "DM Sans",
            "titleFontSize": 14,
            "titleFontWeight": "normal",
            "titleColor": "#20243A",
            "titlePadding": 12,

            "labelFont": "DM Sans",
            "labelFontSize": 13,
            "labelColor": "#20243A",
            "labelPadding": 6,

            "values": [0, 5, 10, 15, 20, 25, 30],

            "grid": false,
            "ticks": true,
            "tickColor": "#20243A",
            "tickSize": 4,

            "domain": true,
            "domainColor": "#20243A",
            "domainWidth": 1
          }
        },

        "x2": {
          "field": "female"
        }
      }
    },

    {
      "transform": [
        {
          "fold": ["male", "female"],
          "as": ["gender", "attendance_rate"]
        },
        {
          "calculate": "datum.gender == 'male' ? 'Male' : 'Female'",
          "as": "gender_label"
        }
      ],

      "mark": {
        "type": "circle",
        "size": 120,
        "opacity": 1,
        "stroke": "#F7F3EB",
        "strokeWidth": 1
      },

      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": [
            "15-17",
            "18-24",
            "25-34",
            "35-44",
            "45-54",
            "55-64",
            "65-74",
            "75+"
          ],
          "title": null
        },

        "x": {
          "field": "attendance_rate",
          "type": "quantitative",
          "scale": {
            "domain": [0, 30]
          }
        },

        "color": {
          "field": "gender_label",
          "type": "nominal",
          "title": "Gender",
          "scale": {
            "domain": ["Male", "Female"],       
            "range": ["#69BBA4", "#A06583"]

          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",

            "titleFont": "DM Sans",
            "titleFontSize": 14,
            "titleFontWeight": "bold",
            "titleColor": "#20243A",

            "labelFont": "DM Sans",
            "labelFontSize": 14,
            "labelColor": "#20243A",

            "symbolType": "circle",
            "symbolSize": 120,
            "offset": 6
          }
        },

        "tooltip": [
          {
            "field": "age_group",
            "type": "nominal",
            "title": "Age group"
          },
          {
            "field": "gender_label",
            "type": "nominal",
            "title": "Gender"
          },
          {
            "field": "attendance_rate",
            "type": "quantitative",
            "title": "Attendance rate (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "age_group": "15-17",
            "note": "Pandemic-era survey\nLive events faced restrictions."
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 8,
        "dy": -8,
        "font": "DM Sans",
        "fontSize": 12,
        "fontWeight": "normal",
        "lineBreak": "\n",
        "lineHeight": 15,
        "color": "#20243A"
      },

      "encoding": {
        "x": {
          "datum": 17.5,
          "type": "quantitative",
          "scale": {
            "domain": [0, 30]
          }
        },

        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": [
            "15-17",
            "18-24",
            "25-34",
            "35-44",
            "45-54",
            "55-64",
            "65-74",
            "75+"
          ]
        },

        "text": {
          "field": "note",
          "type": "nominal"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "age_group": "75+",
            "note": "The survey shows attendance differences,\nnot their causes."
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 8,
        "dy": -10,
        "font": "DM Sans",
        "fontSize": 12,
        "fontWeight": "normal",
        "lineBreak": "\n",
        "lineHeight": 15,
        "color": "#20243A"
      },

      "encoding": {
        "x": {
          "datum": 12.2,
          "type": "quantitative",
          "scale": {
            "domain": [0, 30]
          }
        },

        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": [
            "15-17",
            "18-24",
            "25-34",
            "35-44",
            "45-54",
            "55-64",
            "65-74",
            "75+"
          ]
        },

        "text": {
          "field": "note",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "view": {
      "fill": "#F7F3EB",
      "stroke": null
    }
  }
}