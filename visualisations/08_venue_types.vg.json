
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 290,
  "height": {
    "step": 27
  },
  "background": "#F7F3EB",

  "data": {
    "url": "data/clean/venues_clean.csv",
    "format": {
      "type": "csv"
    }
  },

  "transform": [
    {
      "filter": "isValid(datum.space_type) && datum.space_type != 'Unknown' && datum.space_type != ''"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "venue_count"
        }
      ],
      "groupby": [
        "space_type"
      ]
    },
    {
      "calculate": "datum.space_type == 'Amusement/Theme Venue' ? 'Amusement or theme venue' : datum.space_type == 'Public University/College' ? 'University or college' : datum.space_type == 'Multi-Use' ? 'Multi-use' : datum.space_type",
      "as": "type_label"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "venue_rank"
        }
      ],
      "sort": [
        {
          "field": "venue_count",
          "order": "descending"
        },
        {
          "field": "type_label",
          "order": "ascending"
        }
      ]
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },

      "encoding": {
        "y": {
          "field": "type_label",
          "type": "nominal",
          "sort": {
            "field": "venue_rank",
            "op": "min",
            "order": "ascending"
          },
          "title": null,
          "axis": {
            "labelFont": "DM Sans",
            "labelFontSize": 14,
            "labelFontWeight": "normal",
            "labelColor": "#20243A",
            "labelPadding": 9,
            "labelLimit": 210,
            "ticks": false,
            "domain": false
          }
        },

        "x": {
          "field": "venue_count",
          "type": "quantitative",
          "title": null,
          "scale": {
            "zero": true
          },
          "axis": {
            "labels": false,
            "ticks": false,
            "domain": false,
            "grid": false
          }
        },

        "color": {
          "condition": {
            "test": "datum.space_type == 'Bar'",
            "value": "#514C47"
          },
          "value": "#C9C0B0"
        },

        "tooltip": [
          {
            "field": "type_label",
            "type": "nominal",
            "title": "Venue type"
          },
          {
            "field": "venue_count",
            "type": "quantitative",
            "title": "Number of venues",
            "format": ",d"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.space_type != 'Bar'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "font": "DM Sans",
        "fontSize": 14,
        "fontWeight": "normal",
        "color": "#20243A"
      },

      "encoding": {
        "y": {
          "field": "type_label",
          "type": "nominal",
          "sort": {
            "field": "venue_rank",
            "op": "min",
            "order": "ascending"
          }
        },

        "x": {
          "field": "venue_count",
          "type": "quantitative"
        },

        "text": {
          "field": "venue_count",
          "type": "quantitative",
          "format": ",d"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.space_type == 'Bar'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "font": "DM Sans",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#20243A"
      },

      "encoding": {
        "y": {
          "field": "type_label",
          "type": "nominal",
          "sort": {
            "field": "venue_rank",
            "op": "min",
            "order": "ascending"
          }
        },

        "x": {
          "field": "venue_count",
          "type": "quantitative"
        },

        "text": {
          "field": "venue_count",
          "type": "quantitative",
          "format": ",d"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.space_type == 'Library'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 0,
        "dy": -5,
        "font": "DM Sans",
        "fontSize": 13,
        "fontWeight": "normal",
        "lineBreak": "\n",
        "lineHeight": 18,
        "color": "#20243A"
      },

      "encoding": {
        "x": {
          "value": 115
        },

        "y": {
          "field": "type_label",
          "type": "nominal",
          "sort": {
            "field": "venue_rank",
            "op": "min",
            "order": "ascending"
          }
        },

        "text": {
          "value": "Beyond traditional venues\nLibraries, churches and museums\naccount for 7 venues."
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}
