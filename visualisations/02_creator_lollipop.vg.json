
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 260,
  "background": "#F7F3EB",

  "data": {
    "url": "data/clean/music_qld_clean.csv"
  },

  "transform": [
    {
      "filter": "datum.creator_clean != null && datum.creator_clean != 'Unknown'"
    },
    {
      "calculate": "trim(replace(trim(datum.creator_clean), /\\.$/, ''))",
      "as": "creator_key"
    },
    {
      "calculate": "split(datum.creator_key, ',')[0]",
      "as": "creator_short"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "record_count"
        }
      ],
      "groupby": [
        "creator_key",
        "creator_short"
      ]
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "record_count",
          "order": "descending"
        },
        {
          "field": "creator_key",
          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 8"
    }
  ],

  "encoding": {
    "y": {
      "field": "creator_short",
      "type": "nominal",
      "sort": {
        "field": "rank",
        "op": "min",
        "order": "ascending"
      },
      "axis": {
        "title": null,
        "labelFont": "DM Sans",
        "labelFontSize": 14,
        "labelFontWeight": "normal",
        "labelColor": "#20243A",
        "labelPadding": 12,
        "labelLimit": 170,
        "ticks": false,
        "domain": false
      }
    },

    "x": {
      "field": "record_count",
      "type": "quantitative",
      "title": "Number of preserved records",
      "scale": {
        "domain": [0, 5.6],
        "nice": false,
        "zero": true
      },
      "axis": {
        "values": [0, 1, 2, 3, 4, 5],
        "format": "d",
        "labelFont": "DM Sans",
        "labelFontSize": 13,
        "labelFontWeight": "normal",
        "labelColor": "#6F7180",
        "labelPadding": 8,
        "titleFont": "DM Sans",
        "titleFontSize": 14,
        "titleFontWeight": "normal",
        "titleColor": "#293348",
        "titlePadding": 15,
        "grid": false,
        "domainColor": "#C8C3B6",
        "domainWidth": 1.2,
        "tickColor": "#C8C3B6",
        "tickSize": 6
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 2.5,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.creator_short === 'Egan-Mulry'",
            "value": "#7A5238"
          },
          "value": "#B79A84"
        }
      }
    },
    {
    "transform": [{ "filter": "datum.creator_short === 'Egan-Mulry'" }],
    "mark": { "type": "rule", "stroke": "#946414", "strokeWidth": 1.2 },
    "encoding": { "y2": { "value": 44 } }
    },
    {
    "transform": [{ "filter": "datum.creator_short === 'Egan-Mulry'" }],
    "mark": {
        "type": "text",
        "align": "center",
        "baseline": "top",
        "font": "DM Sans",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#7A5238"
    },
    "encoding": {
        "x": { "datum": 5, "type": "quantitative" },
        "y": { "value": 48 },
        "text": { "value": "Egan-Mulry" }
    }
    },
    {
    "transform": [{ "filter": "datum.creator_short === 'Egan-Mulry'" }],
    "mark": {
        "type": "text",
        "align": "center",
        "baseline": "top",
        "font": "DM Sans",
        "fontSize": 12,
        "lineBreak": "\n",
        "lineHeight": 16,
        "color": "#7A5238"
    },
    "encoding": {
        "x": { "datum": 5, "type": "quantitative" },
        "y": { "value": 65 },
        "text": { "value": "Irish-born\ncomposer of\nFirst World War\npatriotic songs" }
    }
    },
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 240,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.creator_short === 'Egan-Mulry'",
            "value": "#7A5238"
          },
          "value": "#B79A84"
        },
        "tooltip": [
          {
            "field": "creator_key",
            "type": "nominal",
            "title": "Creator"
          },
          {
            "field": "record_count",
            "type": "quantitative",
            "title": "Preserved records",
            "format": "d"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "font": "DM Sans",
        "fontSize": 14,
        "fontWeight": "normal",
        "color": "#20243A"
      },
      "encoding": {
        "text": {
          "field": "record_count",
          "type": "quantitative",
          "format": "d"
        }
      }
    }
  ],

  "padding": {
    "left": 10,
    "right": 18,
    "top": 8,
    "bottom": 8
  },

  "config": {
    "view": {
      "stroke": null
    }
  }
}
