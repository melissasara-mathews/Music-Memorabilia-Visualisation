{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 760,
  "height": 480,

  "background": "#FAF7F1",

  "projection": {
    "type": "equalEarth"
  },

  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/refs/heads/master/states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "transform": [
    {
      "calculate": "datum.properties.STATE_NAME",
      "as": "state_name"
    },

    {
      "calculate": "datum.state_name == 'New South Wales' ? 'NSW' : datum.state_name == 'Australian Capital Territory' ? 'ACT' : datum.state_name",
      "as": "join_state"
    },

    {
      "lookup": "join_state",

      "from": {
        "data": {
          "url": "data/clean/abs_state_attendance.csv",
          "format": {
            "type": "csv",
            "parse": {
              "attendance_rate": "number",
              "attendees_thousands": "number"
            }
          }
        },

        "key": "state",

        "fields": [
          "attendance_rate",
          "attendees_thousands"
        ]
      }
    }
  ],

  "mark": {
    "type": "geoshape",
    "stroke": "#FAF7F1",
    "strokeWidth": 1
  },

  "encoding": {
    "color": {
      "condition": {
        "test": "isValid(datum.attendance_rate)",
        "field": "attendance_rate",
        "type": "quantitative",

        "scale": {
          "scheme": "oranges"
        },

        "legend": {
          "orient": "top",
          "direction": "horizontal",
          "title": "Attendance rate (%)",

          "titleFont": "Arial",
          "titleFontSize": 13,
          "titleColor": "#20243A",

          "labelFont": "Arial",
          "labelFontSize": 12,
          "labelColor": "#20243A"
        }
      },

      "value": "#D8D8D8"
    },

    "tooltip": [
      {
        "field": "state_name",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "attendance_rate",
        "type": "quantitative",
        "title": "Attendance rate (%)",
        "format": ".1f"
      },
      {
        "field": "attendees_thousands",
        "type": "quantitative",
        "title": "Attendees (thousands)",
        "format": ",.1f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    }
  }
}