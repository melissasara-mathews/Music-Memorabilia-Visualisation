
{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 500,
  "height": 305,
  "padding": 8,
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "background": "#F7F3EB",
  "signals": [
    {
      "name": "selectedThemes",
      "value": []
    },
    {
      "name": "ribbonUnit",
      "value": 6
    }
  ],
  "data": [
    {
      "name": "links",
      "url": "./data/clean/creator_theme_links.csv",
      "format": {
        "type": "csv",
        "parse": {
          "record_count": "number"
        }
      },
      "transform": [
        {
          "type": "formula",
          "as": "creatorOrder",
          "expr": "indexof(['Edkins', 'Brier', 'Caflisch', 'Egan-Mulry', 'Wood'], datum.creator_short)"
        },
        {
          "type": "formula",
          "as": "themeOrder",
          "expr": "indexof(['Piano / dance', 'War', 'Other', 'Queensland / place', 'Songs', 'Patriotic / national'], datum.theme)"
        }
      ]
    },
    {
      "name": "creators",
      "source": "links",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["creator_short", "creatorOrder"],
          "fields": ["record_count"],
          "ops": ["sum"],
          "as": ["total"]
        },
        {
          "type": "collect",
          "sort": {
            "field": "creatorOrder",
            "order": "ascending"
          }
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["rank"]
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "55 + (datum.rank - 1) * 52"
        },
        {
          "type": "formula",
          "as": "nodeTop",
          "expr": "datum.y - datum.total * ribbonUnit / 2"
        },
        {
          "type": "formula",
          "as": "nodeBottom",
          "expr": "datum.y + datum.total * ribbonUnit / 2"
        }
      ]
    },
    {
      "name": "themes",
      "source": "links",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["theme", "themeOrder"],
          "fields": ["record_count"],
          "ops": ["sum"],
          "as": ["total"]
        },
        {
          "type": "collect",
          "sort": {
            "field": "themeOrder",
            "order": "ascending"
          }
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["rank"]
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "55 + (datum.rank - 1) * 44"
        },
        {
          "type": "formula",
          "as": "nodeTop",
          "expr": "datum.y - datum.total * ribbonUnit / 2"
        },
        {
          "type": "formula",
          "as": "nodeBottom",
          "expr": "datum.y + datum.total * ribbonUnit / 2"
        }
      ]
    },
    {
      "name": "sankey_links",
      "source": "links",
      "transform": [
        {
          "type": "stack",
          "groupby": ["creator_short"],
          "field": "record_count",
          "sort": {
            "field": "themeOrder",
            "order": "ascending"
          },
          "offset": "zero",
          "as": ["source0", "source1"]
        },
        {
          "type": "stack",
          "groupby": ["theme"],
          "field": "record_count",
          "sort": {
            "field": "creatorOrder",
            "order": "ascending"
          },
          "offset": "zero",
          "as": ["target0", "target1"]
        },
        {
          "type": "lookup",
          "from": "creators",
          "key": "creator_short",
          "fields": ["creator_short"],
          "values": ["nodeTop"],
          "as": ["sourceTop"]
        },
        {
          "type": "lookup",
          "from": "themes",
          "key": "theme",
          "fields": ["theme"],
          "as": ["targetTop"],
          "values": ["nodeTop"]
        },
        {
          "type": "formula",
          "as": "sy0",
          "expr": "datum.sourceTop + datum.source0 * ribbonUnit"
        },
        {
          "type": "formula",
          "as": "sy1",
          "expr": "datum.sourceTop + datum.source1 * ribbonUnit"
        },
        {
          "type": "formula",
          "as": "ty0",
          "expr": "datum.targetTop + datum.target0 * ribbonUnit"
        },
        {
          "type": "formula",
          "as": "ty1",
          "expr": "datum.targetTop + datum.target1 * ribbonUnit"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "themeColor",
      "type": "ordinal",
      "domain": [
        "Songs",
        "Patriotic / national",
        "War",
        "Piano / dance",
        "Queensland / place",
        "Other"
      ],
      "range": [
        "#876EB2",
        "#458C6B",
        "#E75480",
        "#1FA4B6",
        "#FFDB58",
        "#84465C"
      ]
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "sankey_links"
      },
      "encode": {
        "enter": {
          "fill": {
            "scale": "themeColor",
            "field": "theme"
          },
          "stroke": {
            "value": null
          },
          "tooltip": {
            "signal": "{'Creator': datum.creator_short, 'Theme': datum.theme, 'Records': datum.record_count}"
          }
        },
        "update": {
          "path": {
            "signal": "'M 128,' + datum.sy0 + ' C 196,' + datum.sy0 + ' 249,' + datum.ty0 + ' 318,' + datum.ty0 + ' L 318,' + datum.ty1 + ' C 249,' + datum.ty1 + ' 196,' + datum.sy1 + ' 128,' + datum.sy1 + ' Z'"
          },
          "fillOpacity": {
            "signal": "length(selectedThemes) === 0 ? 0.48 : (indexof(selectedThemes, datum.theme) >= 0 ? 0.82 : 0.06)"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "creators"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 115
          },
          "x2": {
            "value": 128
          },
          "y": {
            "field": "nodeTop"
          },
          "y2": {
            "field": "nodeBottom"
          },
          "fill": {
            "value": "#967052"
          },
          "cornerRadius": {
            "value": 2
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "creators"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 105
          },
          "y": {
            "field": "y"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": "normal"
          },
          "fill": {
            "value": "#20243A"
          },
          "text": {
            "field": "creator_short"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "themes"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 318
          },
          "x2": {
            "value": 331
          },
          "y": {
            "field": "nodeTop"
          },
          "y2": {
            "field": "nodeBottom"
          },
          "fill": {
            "scale": "themeColor",
            "field": "theme"
          },
          "cornerRadius": {
            "value": 2
          }
        },
        "update": {
          "fillOpacity": {
            "signal": "length(selectedThemes) === 0 || indexof(selectedThemes, datum.theme) >= 0 ? 1 : 0.18"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "themes"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 344
          },
          "y": {
            "field": "y"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": "normal"
          },
          "fill": {
            "value": "#20243A"
          },
          "text": {
            "field": "theme"
          }
        },
        "update": {
          "opacity": {
            "signal": "length(selectedThemes) === 0 || indexof(selectedThemes, datum.theme) >= 0 ? 1 : 0.25"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 115
          },
          "y": {
            "value": 12
          },
          "text": {
            "value": "Creators"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": "normal"
          },
          "fill": {
            "value": "#59645F"
          },
          "align": {
            "value": "right"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 331
          },
          "y": {
            "value": 12
          },
          "text": {
            "value": "Themes"
          },
          "font": {
            "value": "DM Sans"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": "normal"
          },
          "fill": {
            "value": "#59645F"
          },
          "align": {
            "value": "left"
          }
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
