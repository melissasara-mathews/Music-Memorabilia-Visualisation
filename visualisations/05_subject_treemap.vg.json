
{
    "$schema": "https://vega.github.io/schema/vega/v5.json",
    "width": 470,
    "height": 250,
    "padding": 5,
    "background": "#F7F3EB",

    "data": [
    {
        "name": "subjects",
        "url": "data/clean/subject_hierarchy_detailed.csv",
        "format": {
        "type": "csv",
        "parse": {
            "record_count": "number",
            "level": "number"
        }
        },
        "transform": [
        {
            "type": "formula",
            "as": "parent_clean",
            "expr": "datum.parent == '' ? null : datum.parent"
        },
        {
            "type": "stratify",
            "key": "node_id",
            "parentKey": "parent_clean"
        },
        {
            "type": "treemap",
            "field": "record_count",
            "sort": {
            "field": "value",
            "order": "descending"
            },
            "method": "squarify",
            "ratio": 1.35,
            "round": true,
            "size": [
            {"signal": "width"},
            {"signal": "height"}
            ],
            "paddingInner": 2,
            "paddingOuter": 2,
            "paddingTop": 0
        }
        ]
    }
    ],

    "scales": [
    {
        "name": "subjectColour",
        "type": "ordinal",
        "domain": [
        "Vocal & songs",
        "Instrumental & dance",
        "Nation & patriotism",
        "War & military",
        "Places, people & topics"
        ],
        "range": [
        "#876EB2",
        "#1FA4B6",
        "#458C6B",
        "#E75480",
        "#967052"
        ]
    }
    ],

    "marks": [
    {
        "type": "rect",
        "from": {
        "data": "subjects"
        },
        "encode": {
        "enter": {
            "x": {"field": "x0"},
            "x2": {"field": "x1"},
            "y": {"field": "y0"},
            "y2": {"field": "y1"},
            "fill": {
            "scale": "subjectColour",
            "field": "group"
            },
            "stroke": {"value": "#F7F3EB"},
            "strokeWidth": {"value": 1},
            "tooltip": {
            "signal": "datum.depth == 2 ? {'Subject': datum.label, 'Group': datum.group, 'Assignments': datum.record_count} : null"
            }
        },
        "update": {
            "fillOpacity": {
            "signal": "datum.depth == 2 ? 0.9 : 0"
            }
        },
        "hover": {
            "fillOpacity": {
            "signal": "datum.depth == 2 ? 1 : 0"
            }
        }
        }
    },

    {
        "type": "rect",
        "from": {
        "data": "subjects"
        },
        "encode": {
        "enter": {
            "x": {"field": "x0"},
            "x2": {"field": "x1"},
            "y": {"field": "y0"},
            "y2": {"field": "y1"},
            "fillOpacity": {"value": 0},
            "stroke": {"value": "#F7F3EB"},
            "strokeWidth": {"value": 4}
        },
        "update": {
            "strokeOpacity": {
            "signal": "datum.depth == 1 ? 1 : 0"
            }
        }
        }
    },

    {
        "type": "text",
        "from": {
        "data": "subjects"
        },
        "encode": {
        "enter": {
            "x": {
            "signal": "datum.x0 + 5"
            },
            "y": {
            "signal": "datum.y0 + 5"
            },
            "text": {
            "signal": "datum.depth == 2 && datum.record_count >= 3 && (datum.x1 - datum.x0) > 65 && (datum.y1 - datum.y0) > 24 ? datum.label : ''"
            },
            "font": {"value": "Arial"},
            "fontSize": {"value": 9},
            "fontWeight": {"value": "bold"},
            "fill": {"value": "#FFFFFF"},
            "baseline": {"value": "top"},
            "limit": {
            "signal": "max(0, datum.x1 - datum.x0 - 10)"
            },
            "ellipsis": {"value": "…"}
        }
        }
    }
    ],

    "config": {
    "view": {
        "stroke": null
    }
    }
}
