{
    "$schema": "https://vega.github.io/schema/vega/v5.json",

    "width": 470,
    "height": 250,
    "padding": 5,
    "background": "#FAF7F1",

    "data": [
    {
        "name": "subjects",

        "url": "data/clean/subject_summary.csv",

        "format": {
        "type": "csv",
        "parse": {
            "record_count": "number",
            "percentage": "number"
        }
        },

        "transform": [
        {
            "type": "formula",
            "as": "parent_clean",
            "expr": "datum.parent == '' ? null : datum.parent"
        },

        {
            "type": "stratify",
            "key": "node_id",
            "parentKey": "parent_clean"
        },

        {
            "type": "treemap",
            "field": "record_count",

            "sort": {
            "field": "value",
            "order": "descending"
            },

            "method": "squarify",
            "ratio": 1.35,
            "round": true,

            "size": [
            {
                "signal": "width"
            },
            {
                "signal": "height"
            }
            ],

            "paddingInner": 2
        }
        ]
    }
    ],

    "scales": [
    {
        "name": "subjectColour",

        "type": "ordinal",

        "domain": [
        "Songs with piano",
        "Piano music",
        "Patriotic music",
        "Songs (Medium voice) with piano",
        "Other subjects"
        ],

        "range": [
        "#E85D43",
        "#6A56AF",
        "#E8AA3B",
        "#4E7FA9",
        "#D8CDB8"
        ]
    }
    ],

    "marks": [
    {
        "type": "rect",

        "from": {
        "data": "subjects"
        },

        "encode": {
        "enter": {
            "x": {
            "field": "x0"
            },

            "x2": {
            "field": "x1"
            },

            "y": {
            "field": "y0"
            },

            "y2": {
            "field": "y1"
            },

            "fill": {
            "scale": "subjectColour",
            "field": "subject_primary"
            },

            "stroke": {
            "value": "#FAF7F1"
            },

            "strokeWidth": {
            "value": 4
            },

            "tooltip": {
            "signal": "datum.depth == 1 ? {'Subject': datum.subject_primary, 'Records': datum.record_count, 'Share': datum.percentage + '%'} : null"
            }
        },

        "update": {
            "fillOpacity": {
            "signal": "datum.depth == 1 ? 1 : 0"
            }
        },

        "hover": {
            "fillOpacity": {
            "value": 0.82
            }
        }
        }
    },

    {
    "type": "text",

    "from": {
        "data": "subjects"
    },

    "encode": {
        "enter": {
        "x": {
            "signal": "datum.x0 + 14"
        },

        "y": {
            "signal": "datum.y0 + 16"
        },

        "text": {
        "signal": "datum.depth == 1 ? (datum.subject_primary == 'Songs (Medium voice) with piano' ? 'Medium voice' : datum.subject_primary) : ''"
        },

        "align": {
            "value": "left"
        },

        "baseline": {
            "value": "top"
        },

        "font": {
            "value": "Arial"
        },

        "fontSize": {
        "signal": "(datum.x1 - datum.x0) < 150 ? 8 : 11"
        },

        "fontWeight": {
            "value": "bold"
        },

        "limit": {
            "signal": "max(0, datum.x1 - datum.x0 - 28)"
        },

        "ellipsis": {
            "value": "…"
        },

        "fill": {
            "signal": "datum.subject_primary == 'Other subjects' ? '#20243A' : '#FAF7F1'"
        }
        }
    }
    },

    {
        "type": "text",

        "from": {
        "data": "subjects"
        },

        "encode": {
        "enter": {
            "x": {
            "signal": "datum.x0 + 14"
            },

            "y": {
            "signal": "datum.y1 - 14"
            },

            "text": {
            "signal": "datum.depth == 1 ? datum.percentage + '%' : ''"
            },

            "align": {
            "value": "left"
            },

            "baseline": {
            "value": "bottom"
            },

            "font": {
            "value": "Georgia"
            },

            "fontSize": {
            "signal": "(datum.x1 - datum.x0) < 130 ? 22 : 26"
            },

            "fontWeight": {
            "value": "bold"
            },

            "fill": {
            "signal": "datum.subject_primary == 'Other subjects' ? '#20243A' : '#FAF7F1'"
            }
        }
        }
    }
    ]
}