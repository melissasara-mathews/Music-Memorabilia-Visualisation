{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 430,
  "height": 360,

  "background": "#FAF7F1",

  "projection": {
    "type": "equirectangular",
    "center": [144.97, -37.815],
    "scale": 360000
  },

  "layer": [
    {
      "data": {
        "url": "data/clean/VIC_LOCALITY_POLYGON_SHP.json",
        "format": {
          "type": "topojson",
          "feature": "VIC_LOCALITY_POLYGON_SHP"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#C9D8B6",
        "stroke": "#F7F4EC",
        "strokeWidth": 0.7
      }
    },

    {
      "data": {
        "url": "data/clean/melbourne_rivers.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties['@id'] == 'relation/2211681' || datum.properties['@id'] == 'relation/4762727'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#5DA5D3",
        "strokeWidth": 2,
        "opacity": 0.95
      }
    },

    {
      "data": {
        "values": [
          { "name": "Parkville", "lon": 144.946, "lat": -37.787 },
          { "name": "Carlton", "lon": 144.969, "lat": -37.793 },
          { "name": "Fitzroy", "lon": 144.985, "lat": -37.794 },
          { "name": "Melbourne", "lon": 144.958, "lat": -37.808 },
          { "name": "Richmond", "lon": 145.008, "lat": -37.824 },
          { "name": "South Yarra", "lon": 145.001, "lat": -37.844 }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 11,
        "color": "#59645F",
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },

    {
      "data": {
        "url": "data/clean/venues_clean.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.lat) && isValid(datum.lon)"
        },
        {
          "bin": { "step": 0.01 },
          "field": "lon",
          "as": ["lon_start", "lon_end"]
        },
        {
          "bin": { "step": 0.01 },
          "field": "lat",
          "as": ["lat_start", "lat_end"]
        },
        {
          "aggregate": [
            { "op": "count", "as": "venue_count" }
          ],
          "groupby": [
            "lon_start",
            "lon_end",
            "lat_start",
            "lat_end"
          ]
        },
        {
          "calculate": "(datum.lon_start + datum.lon_end) / 2",
          "as": "cluster_lon"
        },
        {
          "calculate": "(datum.lat_start + datum.lat_end) / 2",
          "as": "cluster_lat"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#E85D43",
        "opacity": 0.72,
        "stroke": "#B94330",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "cluster_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "cluster_lat",
          "type": "quantitative"
        },
        "size": {
          "field": "venue_count",
          "type": "quantitative",
          "title": "Number of venues",
          "scale": {
            "range": [80, 1800]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": "Number of venues",
            "titleFont": "Arial",
            "titleFontSize": 12,
            "titleColor": "#20243A",
            "labelFont": "Arial",
            "labelFontSize": 11,
            "labelColor": "#20243A",
            "symbolFillColor": "#E85D43",
            "symbolStrokeColor": "#B94330"
          }
        },
        "tooltip": [
          {
            "field": "venue_count",
            "type": "quantitative",
            "title": "Venues in area",
            "format": ",d"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "fill": "#BFDFF2",
      "stroke": null
    }
  }
}