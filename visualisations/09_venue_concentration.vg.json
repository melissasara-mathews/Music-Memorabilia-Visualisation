        }
      }
    },

    {
      "data": {
        "url": "data/clean/venues_clean.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.lat) && isValid(datum.lon)"
        },
        {
          "bin": {
            "step": 0.01
          },
          "field": "lon",
          "as": ["lon_start", "lon_end"]
        },
        {
          "bin": {
            "step": 0.01
          },
          "field": "lat",
          "as": ["lat_start", "lat_end"]
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "venue_count"
            },
            {
              "op": "mean",
              "field": "lon",
              "as": "cluster_lon"
            },
            {
              "op": "mean",
              "field": "lat",
              "as": "cluster_lat"
            }
          ],
          "groupby": [
            "lon_start",
            "lon_end",
            "lat_start",
            "lat_end"
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "cluster_rank"
            }
          ],
          "sort": [
            {
              "field": "venue_count",
              "order": "descending"
            },
            {
              "field": "cluster_lon",
              "order": "ascending"
            },
            {
              "field": "cluster_lat",
              "order": "ascending"
            }
          ]
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#E85D43",
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {
          "field": "cluster_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "cluster_lat",
          "type": "quantitative"
        },
        "size": {
          "field": "venue_count",
          "type": "quantitative",
          "title": "Number of venues",
          "scale": {
            "type": "linear",
            "zero": true,
            "range": [80, 1800]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "offset": 6,
            "values": [5, 20, 50, 90],
            "title": "Number of venues",
            "titleFont": "Arial",
            "titleFontSize": 12,
            "titleColor": "#20243A",
            "labelFont": "Arial",
            "labelFontSize": 11,
            "labelColor": "#20243A",
            "symbolFillColor": "#E85D43",
            "symbolStrokeColor": "#A83E30",
            "symbolStrokeWidth": 1
          }
        },
        "stroke": {
          "condition": {
            "test": "datum.cluster_rank == 1",
            "value": "#20243A"
          },
          "value": "#A83E30"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.cluster_rank == 1",
            "value": 2.5
          },
          "value": 1
        },
        "tooltip": [
          {
            "field": "venue_count",
            "type": "quantitative",
            "title": "Venues in this area",
            "format": ",d"
          }
        ]
      }
    },

    {
      "data": {
        "url": "data/clean/venues_clean.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.lat) && isValid(datum.lon)"
        },
        {
          "bin": {
            "step": 0.01
          },
          "field": "lon",
          "as": ["lon_start", "lon_end"]
        },
        {
          "bin": {
            "step": 0.01
          },
          "field": "lat",
          "as": ["lat_start", "lat_end"]
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "venue_count"
            },
            {
              "op": "mean",
              "field": "lon",
              "as": "cluster_lon"
            },
            {
              "op": "mean",
              "field": "lat",
              "as": "cluster_lat"
            }
          ],
          "groupby": [
            "lon_start",
            "lon_end",
            "lat_start",
            "lat_end"
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "cluster_rank"
            }
          ],
          "sort": [
            {
              "field": "venue_count",
              "order": "descending"
            },
            {
              "field": "cluster_lon",
              "order": "ascending"
            },
            {
              "field": "cluster_lat",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.cluster_rank == 1"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#FFFFFF",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "cluster_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "cluster_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "venue_count",
          "type": "quantitative",
          "format": ",d"
        }
      }
    },

    {
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "rect",
        "color": "#F7F3EB",
        "opacity": 0.97,
        "cornerRadius": 5
      },
      "encoding": {
        "x": {"value": 9},
        "x2": {"value": 200},
        "y": {"value": 250},
        "y2": {"value": 355}
      }
    },

    {
      "data": {
        "url": "data/clean/venues_clean.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.lat) && isValid(datum.lon)"
        },
        {
          "bin": {
            "step": 0.01
          },
          "field": "lon",
          "as": ["lon_start", "lon_end"]
        },
        {
          "bin": {
            "step": 0.01
          },
          "field": "lat",
          "as": ["lat_start", "lat_end"]
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "venue_count"
            }
          ],
          "groupby": [
            "lon_start",
            "lon_end",
            "lat_start",
            "lat_end"
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "venue_count",
              "as": "total_venues"
            }
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "cluster_rank"
            }
          ],
          "sort": [
            {
              "field": "venue_count",
              "order": "descending"
            },
            {
              "field": "lon_start",
              "order": "ascending"
            },
            {
              "field": "lat_start",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.cluster_rank == 1"
        },
        {
          "calculate": "format(100 * datum.venue_count / datum.total_venues, '.1f') + '% in one grid cell'",
          "as": "share_label"
        },
        {
          "calculate": "datum.venue_count + ' of ' + datum.total_venues + ' mapped venues'",
          "as": "count_label"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 13,
            "fontWeight": "bold",
            "color": "#20243A",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "value": 19
            },
            "y": {
              "value": 267
            },
            "text": {
              "field": "share_label",
              "type": "nominal"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 12,
            "color": "#424B49",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "value": 19
            },
            "y": {
              "value": 288
            },
            "text": {
              "field": "count_label",
              "type": "nominal"
            }
          }
        }
      ]
    },

